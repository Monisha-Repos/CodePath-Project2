classDiagram
    %% Final design: matches pawpal_system.py

    class Task {
        <<dataclass>>
        +str description
        +str time
        +int duration_minutes
        +str priority
        +str frequency
        +date due_date
        +bool completed
        +str pet_name
        +__post_init__()
        +mark_complete()
        +next_occurrence() Task | None
    }

    class Pet {
        <<dataclass>>
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task)
        +remove_task(task)
    }

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet)
        +get_pet(name) Pet | None
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +Owner owner
        -_tasks(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_tasks(tasks, pet_name, completed) list~Task~
        +detect_conflicts(tasks) list~str~
        +mark_task_complete(task) Task | None
        +get_todays_schedule(day) list~Task~
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Scheduler --> Owner : reads tasks via get_all_tasks()
    Scheduler ..> Task : sorts / filters / completes
    Task ..> Task : next_occurrence() creates
